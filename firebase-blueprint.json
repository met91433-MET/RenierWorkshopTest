{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "System user account with specific ERP permission flags",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Auth User ID" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "permissions": {
          "type": "object",
          "description": "Granular user feature permissions",
          "properties": {
            "canReceive": { "type": "boolean" },
            "canInspect": { "type": "boolean" },
            "canQuote": { "type": "boolean" },
            "canCreateJobCard": { "type": "boolean" },
            "canStores": { "type": "boolean" },
            "canWorksheet": { "type": "boolean" },
            "canReporting": { "type": "boolean" },
            "canClose": { "type": "boolean" },
            "isAdmin": { "type": "boolean" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer contact information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "contactPerson": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name"]
    },
    "ComponentMatrix": {
      "title": "Component Pricing Matrix",
      "description": "Pricing matrix for a specific component type (e.g. Spindle, Wheel Hub) mapping steps to model pricing",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Component component type, e.g., Spindle" },
        "name": { "type": "string", "description": "Component name" },
        "models": {
          "type": "array",
          "description": "List of available models (columns)"
        },
        "steps": {
          "type": "array",
          "description": "List of repair steps with pricing per model",
          "items": {
            "type": "object",
            "properties": {
              "stepName": { "type": "string" },
              "prices": {
                "type": "object",
                "description": "Mapping of modelName to price"
              }
            }
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name"]
    },
    "Job": {
      "title": "Job",
      "description": "A repair job tracking the component repair flow",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "deliveryNoteNumber": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "componentType": { "type": "string" },
        "modelName": { "type": "string" },
        "serialNumber": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["Received", "Inspected", "PreQuoted", "JobCardCreated", "Closed"]
        },
        "customFields": {
          "type": "object",
          "description": "Dynamically added receiving columns"
        },
        "files": {
          "type": "array",
          "description": "Stored documents/pictures as base64/data URLs",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string" },
              "size": { "type": "number" },
              "dataUrl": { "type": "string" },
              "uploadedAt": { "type": "string" }
            }
          }
        },
        "dateReceived": { "type": "string" },
        "capturedBy": { "type": "string" },
        "inspectionDetails": {
          "type": "object",
          "properties": {
            "inspectorName": { "type": "string" },
            "inspectedAt": { "type": "string" },
            "customerInstructions": { "type": "string" },
            "inspectorNotes": { "type": "string" },
            "findings": { "type": "string" }
          }
        },
        "preQuoteDetails": {
          "type": "object",
          "properties": {
            "steps": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "stepName": { "type": "string" },
                  "price": { "type": "number" },
                  "isCustom": { "type": "boolean" }
                }
              }
            },
            "totalCost": { "type": "number" },
            "quotedAt": { "type": "string" },
            "quotedBy": { "type": "string" }
          }
        },
        "jobCardDetails": {
          "type": "object",
          "properties": {
            "assignedTechnician": { "type": "string" },
            "scheduledDate": { "type": "string" },
            "requiredParts": { "type": "string" },
            "instructions": { "type": "string" },
            "jobCardCreatedAt": { "type": "string" },
            "jobCardCreatedBy": { "type": "string" }
          }
        },
        "closingDetails": {
          "type": "object",
          "properties": {
            "closedAt": { "type": "string" },
            "closedBy": { "type": "string" },
            "closingNotes": { "type": "string" },
            "qualityReleaseSign": { "type": "string" }
          }
        },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "deliveryNoteNumber", "customerId", "status"]
    },
    "Config": {
      "title": "System Configuration",
      "description": "Global custom configurations (like dynamic job columns)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customColumns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "type": { "type": "string" }
            }
          }
        }
      },
      "required": ["id"]
    },
    "Machine": {
      "title": "Machine Equipment",
      "description": "Plant machinery equipment specification and record card",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "machineName": { "type": "string" },
        "serialNumber": { "type": "string" },
        "model": { "type": "string" },
        "make": { "type": "string" },
        "customerName": { "type": "string" },
        "location": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "machineName", "serialNumber"]
    },
    "ToolStockItem": {
      "title": "Tool Stock Item",
      "description": "Tool inventory item with sign out tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "typeSize": { "type": "string" },
        "quantity": { "type": "number" },
        "addedDate": { "type": "string" },
        "employeeNumber": { "type": "string" },
        "signOutDate": { "type": "string" },
        "dateReturn": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "description", "typeSize"]
    },
    "ConsumableItem": {
      "title": "Consumable Item",
      "description": "Workshop consumable item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "typeSize": { "type": "string" },
        "quantity": { "type": "number" },
        "addedDate": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "description", "typeSize", "quantity"]
    },
    "ConsumableAllocationLog": {
      "title": "Consumable Allocation Log",
      "description": "Log of consumable allocation to employee, job and machine",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "consumableId": { "type": "string" },
        "consumableDescription": { "type": "string" },
        "consumableTypeSize": { "type": "string" },
        "clockNumber": { "type": "string" },
        "jobNumber": { "type": "string" },
        "machineNumber": { "type": "string" },
        "quantityAllocated": { "type": "number" },
        "allocatedAt": { "type": "string" },
        "loggedBy": { "type": "string" }
      },
      "required": ["id", "consumableId", "clockNumber", "jobNumber"]
    },
    "ToolLog": {
      "title": "Tool Log",
      "description": "Log of tool sign outs, returns, additions and deletions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "toolId": { "type": "string" },
        "toolDescription": { "type": "string" },
        "toolTypeSize": { "type": "string" },
        "action": { "type": "string" },
        "clockNumber": { "type": "string" },
        "actionDate": { "type": "string" },
        "loggedBy": { "type": "string" }
      },
      "required": ["id", "toolDescription", "action", "actionDate"]
    },
    "WorksheetEntry": {
      "title": "Worksheet Entry",
      "description": "Daily workshop timesheet entry per machine page, job number, clock number and operation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "pageNumber": { "type": "number" },
        "bookNumber": { "type": "string" },
        "machineId": { "type": "string" },
        "machineSerialNumber": { "type": "string" },
        "machineName": { "type": "string" },
        "clockNumber": { "type": "string" },
        "operatorName": { "type": "string" },
        "jobDate": { "type": "string" },
        "jobNumber": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "durationMinutes": { "type": "number" },
        "durationHours": { "type": "number" },
        "operation": { "type": "string" },
        "notes": { "type": "string" },
        "capturedBy": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "pageNumber", "clockNumber", "jobDate", "jobNumber", "startTime", "endTime", "operation"]
    },
    "AppNotification": {
      "title": "Application Notification",
      "description": "Role-specific and general system alerts with interactive acknowledgement and dismissal tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "targetPermission": { "type": "string" },
        "jobId": { "type": "string" },
        "jobNo": { "type": "string" },
        "customerName": { "type": "string" },
        "componentName": { "type": "string" },
        "targetTab": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdByUid": { "type": "string" },
        "createdByName": { "type": "string" },
        "readBy": { "type": "array", "items": { "type": "string" } },
        "dismissedBy": { "type": "array", "items": { "type": "string" } },
        "dismissedAt": { "type": "object" }
      },
      "required": ["id", "title", "message", "createdAt"]
    },
    "ChatMessage": {
      "title": "Company Group Chat Message",
      "description": "Real-time communication message between workshop staff",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderUid": { "type": "string" },
        "senderName": { "type": "string" },
        "senderEmail": { "type": "string" },
        "senderRole": { "type": "string" },
        "text": { "type": "string" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "reactions": { "type": "object" }
      },
      "required": ["id", "senderUid", "senderName", "text", "createdAt"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "User profiles and permission records"
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Customer contact directory"
    },
    "/components/{componentId}": {
      "schema": "ComponentMatrix",
      "description": "Component repair steps and model matrices"
    },
    "/jobs/{jobId}": {
      "schema": "Job",
      "description": "Active and closed repair job cards"
    },
    "/machines/{machineId}": {
      "schema": "Machine",
      "description": "Machine equipment records and specs"
    },
    "/config/{configId}": {
      "schema": "Config",
      "description": "Global settings such as dynamic table columns"
    },
    "/tool_stock/{toolId}": {
      "schema": "ToolStockItem",
      "description": "Tool stock items and sign out tracking"
    },
    "/tool_logs/{logId}": {
      "schema": "ToolLog",
      "description": "Audit trail of tool sign outs, returns, additions and deletions"
    },
    "/consumables/{consumableId}": {
      "schema": "ConsumableItem",
      "description": "Workshop consumable supplies"
    },
    "/consumable_allocations/{allocationId}": {
      "schema": "ConsumableAllocationLog",
      "description": "Audit trail of consumable issues"
    },
    "/worksheet_entries/{entryId}": {
      "schema": "WorksheetEntry",
      "description": "Captured daily machine worksheet and timesheet log entries"
    },
    "/notifications/{notificationId}": {
      "schema": "AppNotification",
      "description": "Interactive workflow notifications and history logs"
    },
    "/chat_messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Company group chat messages"
    }
  }
}
